# ============================================================
# 拾光 环境变量清单（KEY=VALUE，每行一条；本文件已纳入版本管理，不要写真实密钥）
#
# 用法：
#   本机开发  -> 复制成 .devtools/oss.env 填上 OSS / 短信，start-all.ps1 会自动加载
#   服务器部署 -> 把下面【生产必填】的项写进 systemd 的 EnvironmentFile，见 docs/ 部署说明
#
# 设计原则：生产 profile 下密钥类变量【不给默认值】，
# 缺了会直接启动失败并报出变量名，而不是悄悄退回 dev 弱口令 / 本地存储。
# ============================================================

# ========== 运行模式（服务器必填） ==========
# 本机开发留空（默认 dev）；服务器填 prod
SPRING_PROFILES_ACTIVE=prod
# 时区：JVM 默认可能是 UTC，会让"发布时间"整体差 8 小时
TZ=Asia/Shanghai

# ========== 数据库（服务器必填；本机开发不用填） ==========
# 主机/端口/库名有默认值（127.0.0.1:3306/shiguang），用户名密码【没有默认值】
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shiguang
DB_USERNAME=
DB_PASSWORD=

# ========== Redis（服务器必填密码；本机开发不用填） ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== RabbitMQ（服务器必填账号；别用默认 guest） ==========
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USERNAME=
RABBIT_PASSWORD=

# ========== JWT 密钥（服务器必填，最关键的一项） ==========
# 生成：openssl rand -base64 48
# 不填的后果：仓库里那份默认密钥是公开的，任何人都能伪造任意用户登录
JWT_SECRET=

# ========== 后端允许的跨域来源（服务器必填） ==========
# 站点自己访问时是同源、用不到跨域；这里只放行站点自己的来源，多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://123.57.252.14

# ========== 对象存储：阿里云 OSS ==========
# minio = 本地开发；oss = 生产（媒体直连 OSS，字节流不经过应用服务器）
STORAGE_TYPE=oss
# 公网 endpoint，形如 oss-cn-beijing.aliyuncs.com（控制台"概览"里能看到）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# 内网 endpoint，形如 oss-cn-beijing-internal.aliyuncs.com
# 后端转码要下载源文件、上传转码结果，填了内网就走内网，同地域免流量费（这条是真金白银）
OSS_INTERNAL_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
# 浏览器访问媒体的前缀，留空则自动用 https://{bucket}.{endpoint}；以后接 CDN 只改这一项
OSS_PUBLIC_BASE_URL=
OSS_BUCKET=shiguang-bucket
# RAM 子账号，只授这个 bucket 的读写权限，别用主账号 AK
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ========== 转码 ==========
# 本机指向下载好的 ffmpeg.exe；Linux 服务器一般是 /usr/bin/ffmpeg（prod 默认值就是它）
FFMPEG_PATH=

# ========== 日志（服务器可选） ==========
# prod 默认 logs/shiguang.log（相对启动目录）；想放别处就填绝对路径
LOG_PATH=

# ========== 短信：阿里云号码认证服务·短信认证（当前方案） ==========
# 为什么用它：签名和模板用阿里云「赠送」的，不需要申请资质、不走人工审核；
# 代价是短信里显示的签名由阿里云指定（不是「拾光」）。
# 控制台要选两样东西：「赠送签名配置」和「赠送模板配置」，把选中的值填到下面两行。
#
# pnvs = 号码认证服务·短信认证（prod 默认）；aliyun = 标准短信服务；mock = 固定验证码 123456（仅本地）
SMS_PROVIDER=pnvs
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 「赠送签名配置」里选中的签名名称（形如：恒创联众）
SMS_SIGN_NAME=
# 「赠送模板配置」里选中的模板 CODE（形如：100001）
SMS_TEMPLATE_CODE=
# 赠送模板的变量格式不固定：留空即用默认 {"code":"{code}","min":"{min}"}；
# 如果发送报模板参数错误，就照着控制台里模板的实际内容改这一行
SMS_PNVS_TEMPLATE_PARAM=
# 方案名称，不填即「默认方案」
SMS_PNVS_SCHEME_NAME=
SMS_PNVS_ENDPOINT=dypnsapi.aliyuncs.com

# ---------- 备选：标准短信服务（等有了备案域名 / 小程序，再审自己的签名） ----------
# 切回这条时把上面的 SMS_PROVIDER 改成 aliyun，签名和模板换成自己申请并通过审核的
SMS_ENDPOINT=dysmsapi.aliyuncs.com
